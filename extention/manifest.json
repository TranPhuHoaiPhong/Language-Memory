{
  "manifest_version": 3,

  "name": "Language Memory - Novaryn",

  "version": "1.0.0.0",

  "description": "Translate YouTube subtitles into your native language.",

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png"
    }
  },

  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },

  "web_accessible_resources": [{
    "resources": [
      "icons/*.png"
    ],
    "matches": [
      "<all_urls>"
    ]
  }],

  "permissions": [
    "storage",
    "activeTab"
  ],


  "host_permissions": [
    "http://localhost:3000/*",
    "https://www.youtube.com/*"
  ],


  "content_scripts": [{
    "matches": [
      "https://www.youtube.com/watch*"
    ],

    "js": [
      "utils/utils.js",
      "utils/popup.js",
      "style/style.js",
      "content/youtube.js"
    ]
  }]
}