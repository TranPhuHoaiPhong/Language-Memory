{
  "manifest_version": 3,

  "name": "YouTube Subtitle Translator",
  "version": "1.0.0.0",
  "description": "Translate YouTube subtitles into your native language.",

  "action": {
    "default_title": "Cài đặt LINGO",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png"
    }
  },

  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/2.svg"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],

  "permissions": ["storage", "activeTab"],

  "host_permissions": ["http://localhost:8000/*", "https://www.youtube.com/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
